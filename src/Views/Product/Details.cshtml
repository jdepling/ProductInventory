@model ProductViewModel

<table class="table table-striped table-hover">
    <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Status</th>
        <th>Edit</th>
    </tr>
   
        <tr>
            <td class="col-md-2">@Model.Name</td>
            <td class="col-md-2">@Model.Description</td>
            <td class="col-md-2">@Model.Quantity</td>
            <td class="col-md-2">@Model.Price.ToString("C")</td>
            <td class="col-md-2">
                @if (Model.IsInStock)
                {
                    <span class="badge bg-success">In Stock</span>
                }
                else
                {
                    <span class="badge bg-danger">Out of Stock</span>
                }
            </td>
            <td><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">Edit</a></td>
        </tr>
</table>